# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single shared passcode gating the whole site
SITE_PASSCODE=

# Random long string used to sign the login session cookie (any random string works)
SESSION_SECRET=

# Anthropic API key, for the "Ask AI" chat feature (get one at
# https://console.anthropic.com/settings/keys). Optional - if unset, the
# chat button still shows but returns a config-missing error when used.
ANTHROPIC_API_KEY=

# Resend API key for daily report emails (get one at https://resend.com,
# free tier). Optional - auto-generate still creates/saves the report
# without it, it just can't email it.
RESEND_API_KEY=

# Comma-separated list of emails to send daily reports to.
REPORT_EMAIL_RECIPIENTS=

# Shared secret the external cron service must pass to trigger
# /api/reports/auto-generate (as ?secret=... or an Authorization: Bearer
# header). Make up any random string - this is what keeps that endpoint
# from being triggerable by anyone on the internet, since it has to be
# reachable without the normal login.
REPORTS_CRON_SECRET=
